<view class="page">
  <image class="bg" src="/images/question.png" mode="aspectFill" />
  <view class="mask"></view>

  <view class="stack">
    <navigation-bar
      title="我给好友的互测"
      back="{{true}}"
      color="rgba(0,0,0,0.72)"
      background="transparent"
    ></navigation-bar>

    <view class="subtitle"><text>查看你为好友作答的互测，及与对方自测的认知差异。</text></view>

    <scroll-view scroll-y class="list-scroll" show-scrollbar="{{false}}">
      <view class="qy-scroll-fill" style="min-height: {{scrollInnerMinPx}}px;">
        <view class="qy-scroll-fill__grow"></view>
        <view class="qy-scroll-fill__main">
          <view wx:if="{{!rows.length}}" class="empty-hint">
            <text>暂无记录。完成好友分享的互测邀请后，会出现在这里。</text>
          </view>
          <!-- 卡片样式与同项目 mutual-results-detail「朋友们眼中的你」列表对齐 -->
          <view class="card" wx:for="{{rows}}" wx:key="id">
            <image
              wx:if="{{item.friendAvatarUrl && !item.friendAvatarLoadFailed}}"
              class="avatar"
              src="{{item.friendAvatarUrl}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onFriendAvatarError"
            />
            <view wx:else class="avatar avatar--ph"></view>

            <view class="card-mid">
              <text class="mid-name">{{item.friendNickName}}</text>
              <view class="mid-row">
                <text class="mid-label">朋友测试结果：</text>
                <text class="mid-code">{{item.peerSelfType}}</text>
              </view>
              <view class="mid-row">
                <text class="mid-label">本人测试结果：</text>
                <text class="mid-code">{{item.compareMutualType}}</text>
              </view>
              <text class="mid-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
            </view>

            <view class="card-tail">
              <view class="tail-chip-wrap">
                <view class="chip {{item.chipSame ? 'chip--same' : 'chip--diff'}}">{{item.chipText}}</view>
              </view>
              <view class="btn-analyze" hover-class="btn-analyze--hover" data-id="{{item.id}}" catchtap="onOpenCompare"
                >看分析</view>
            </view>
          </view>
          <view class="list-footer-spacer"></view>
        </view>
      </view>
    </scroll-view>

    <view class="bottom-actions safe-bottom">
      <view class="action-lemon" bindtap="onBackRecords">回到测试记录</view>
    </view>
  </view>
</view>
