@import '../../styles/code-theme.wxss';

page {
  height: 100%;
  min-height: 100vh;
  background: var(--qy-page-tint);
}

.page {
  position: relative;
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
}

.stack {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  height: 100%;
}

.subtitle {
  padding: 8rpx 40rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--qy-text-mute);
}

.list-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.empty-hint {
  padding: 48rpx 0;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--qy-text-mute);
}

/* 与测试记录页 rec-card + rec-actions + btn-info 一致 */
.rec-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 28rpx 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 48rpx;
  border: 2rpx solid var(--qy-card-stroke);
  box-shadow: 0 16rpx 16rpx rgba(0, 0, 0, 0.12);
}

.given-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.given-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.given-avatar--ph {
  background: rgba(213, 241, 228, 0.9);
}

.rec-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.given-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(40, 38, 36, 0.92);
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.given-type-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.given-type-stack .rec-type {
  display: block;
  line-height: 1.1;
}

.given-type-stack .rec-alias {
  display: block;
  line-height: 1.25;
}

.rec-type {
  font-size: 68rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.82);
  line-height: 1.1;
}

.rec-alias {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  line-height: 1.2;
}

.rec-time {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--qy-text-mute);
}

.rec-actions {
  flex-shrink: 0;
  width: 192rpx;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.btn-info {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(224, 214, 182, 0.95);
  box-sizing: border-box;
}

.list-footer-spacer {
  height: 24rpx;
}

.bottom-actions {
  flex-shrink: 0;
  padding: 16rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-lemon {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: var(--qy-lemon);
  border: 2rpx solid var(--qy-card-stroke);
  box-sizing: border-box;
}
