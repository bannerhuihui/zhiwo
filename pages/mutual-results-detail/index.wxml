<view class="page">
  <image class="bg" src="/images/question.png" mode="aspectFill" />
  <view class="mask"></view>

  <view class="stack stack--loading" wx:if="{{loading}}">
    <navigation-bar
      extClass="quiz-nav-layer"
      title="朋友们眼中的你"
      back="{{true}}"
      color="rgba(0,0,0,0.72)"
      background="transparent"
    ></navigation-bar>
    <view class="loading-tip">加载中…</view>
  </view>

  <view class="stack" wx:if="{{!loading}}">
    <navigation-bar
      extClass="quiz-nav-layer"
      title="朋友们眼中的你"
      back="{{true}}"
      color="rgba(0,0,0,0.72)"
      background="transparent"
    ></navigation-bar>

    <view class="sub-line" wx:if="{{showSelfSub}}">你的自测结果：{{selfType}}</view>

    <scroll-view wx:if="{{rows.length}}" scroll-y class="list-scroll" enhanced show-scrollbar="{{false}}">
      <view class="qy-scroll-fill" style="min-height: {{scrollInnerMinPx}}px;">
        <view class="qy-scroll-fill__grow"></view>
        <view class="qy-scroll-fill__main">
      <view class="card" wx:for="{{rows}}" wx:key="id">
        <image wx:if="{{item.friendAvatarUrl}}" class="avatar" src="{{item.friendAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar--ph"></view>

        <view class="card-mid">
          <text class="name">{{item.friendNickName}}</text>
          <view class="chip {{item.chipSame ? 'chip--same' : 'chip--diff'}}">{{item.chipText}}</view>
          <text class="result-line">TA眼中的你：{{item.friendType}}</text>
          <text class="time-line" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>

        <view class="btn-analyze" data-id="{{item.id}}" bindtap="onOpenCompare">看分析</view>
      </view>
      <view class="list-pad"></view>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="empty-box">
      <text class="empty-txt">暂无互测数据</text>
    </view>

    <view class="bottom safe-bottom">
      <view class="btn-back" bindtap="onBack">{{backLabel}}</view>
    </view>
  </view>
</view>
