@import '../../styles/code-theme.wxss';

page {
  height: 100%;
  min-height: 100vh;
  background: var(--qy-page-tint);
}

.page {
  position: relative;
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.1);
}

.stack {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.stack--loading {
  background: transparent;
}

.loading-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--qy-text-mute);
}

.sub-line {
  padding: 4rpx 40rpx 20rpx;
  font-size: 36rpx;
  color: var(--qy-text-mute);
}

.list-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 212rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 48rpx;
  border: 2rpx solid var(--qy-card-stroke);
  box-shadow: 0 14rpx 14rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.avatar--ph {
  background: rgba(213, 241, 228, 0.9);
}

.card-mid {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  line-height: 1.2;
}

.chip {
  display: inline-block;
  margin-top: 12rpx;
  padding: 0 18rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.chip--same {
  color: var(--qy-chip-same);
  background: rgba(201, 239, 216, 0.98);
  border: 2rpx solid rgba(151, 210, 177, 0.95);
}

.chip--diff {
  color: var(--qy-chip-diff);
  background: rgba(255, 228, 216, 0.98);
  border: 2rpx solid rgba(240, 176, 150, 0.95);
}

.result-line {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  color: var(--qy-text-mute);
}

.time-line {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--qy-text-mute);
  opacity: 0.85;
}

.btn-analyze {
  flex-shrink: 0;
  width: 200rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  margin-left: 16rpx;
  border-radius: 999rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: rgba(198, 240, 219, 0.92);
  border: 2rpx solid rgba(160, 215, 194, 0.95);
  box-sizing: border-box;
}

.list-pad {
  height: 24rpx;
}

.empty-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.empty-txt {
  font-size: 30rpx;
  color: var(--qy-text-mute);
}

.bottom {
  flex-shrink: 0;
  padding: 16rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-back {
  height: 116rpx;
  line-height: 116rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: var(--qy-lemon);
  border: 2rpx solid var(--qy-card-stroke);
  box-sizing: border-box;
}
