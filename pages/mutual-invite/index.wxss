page {
  height: 100%;
  min-height: 100vh;
  background: #f7f2df;
}

.page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.layer-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.ui-layer {
  position: relative;
  z-index: 4;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.body {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* 与 index.png 顶部主标题错开，避免与说明文案重叠 */
  padding: calc(612rpx + env(safe-area-inset-top)) 48rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 0;
}

/* code: bold s(22) 居中主说明 */
.copy-block {
  flex: 1;
  min-height: 120rpx;
}

.lead {
  display: block;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.45;
  color: rgba(32, 32, 32, 0.88);
}

.hint {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 34rpx;
  line-height: 1.55;
  color: var(--qy-text-mute);
}

/* code: lemon 主按钮 + 阴影，与 home 早期主按钮一致 */
.actions {
  flex-shrink: 0;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.btn-lemon {
  height: 128rpx;
  line-height: 128rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: var(--qy-lemon);
  border: 2rpx solid var(--qy-card-stroke);
  box-shadow: 0 20rpx 36rpx rgba(0, 0, 0, 0.24);
  box-sizing: border-box;
}

.btn-second {
  margin-top: 36rpx;
}

.notice {
  flex-shrink: 0;
  margin-top: 28rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  color: rgba(129, 124, 124, 0.78);
}
