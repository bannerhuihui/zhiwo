@import '../../styles/code-theme.wxss';

page {
  height: 100%;
  min-height: 100vh;
  background: var(--qy-page-tint);
}

.page {
  position: relative;
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.1);
}

.stack {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 16rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.76);
  border-radius: 48rpx;
  border: 2rpx solid var(--qy-card-stroke);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.card-types {
  padding-bottom: 32rpx;
}

.types-row {
  display: flex;
  flex-direction: row;
}

.types-col {
  flex: 1;
  min-width: 0;
}

.types-col--right {
  padding-left: 16rpx;
  border-left: 2rpx solid rgba(0, 0, 0, 0.06);
}

.types-label {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  line-height: 1.3;
}

.types-code {
  display: block;
  margin-top: 16rpx;
  font-size: 84rpx;
  font-weight: 700;
  color: rgba(30, 30, 30, 0.9);
  line-height: 1.1;
}

.card-score {
  padding: 32rpx 32rpx 36rpx;
}

.score-num {
  display: block;
  font-size: 96rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  line-height: 1.1;
}

.score-cap {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
}

.score-title {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  line-height: 1.45;
  color: var(--qy-text-mute);
}

.card-note {
  background: rgba(255, 255, 255, 0.72);
}

.note-p {
  display: block;
  font-size: 36rpx;
  line-height: 1.5;
  color: var(--qy-text-mute);
  margin-bottom: 16rpx;
}

.note-p:last-child {
  margin-bottom: 0;
}

.btn-copy {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--qy-link-strong);
  background: var(--qy-lemon);
  border: 2rpx solid var(--qy-card-stroke);
  box-sizing: border-box;
  margin-top: 8rpx;
}

.scroll-pad {
  height: 16rpx;
}
