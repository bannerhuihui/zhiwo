<view class="page">
  <image class="bg" src="/images/question.png" mode="aspectFill" />
  <view class="mask"></view>

  <view class="stack">
    <navigation-bar title="知我几分分析" back="{{true}}" color="rgba(0,0,0,0.78)" background="rgba(247,242,223,0.92)"></navigation-bar>

    <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
      <view class="qy-scroll-fill" style="min-height: {{scrollInnerMinPx}}px;">
        <view class="qy-scroll-fill__grow"></view>
        <view class="qy-scroll-fill__main">
      <view class="card card-types">
        <view class="types-row">
          <view
            class="types-col types-col--tap"
            hover-class="types-col--tap-hover"
            bindtap="onOpenSelfType"
          >
            <text class="types-label">{{selfTypesLabel}}</text>
            <text class="types-code">{{selfType}}</text>
            <text class="types-alias">{{selfAlias}}</text>
          </view>
          <view
            class="types-col types-col--right types-col--tap"
            hover-class="types-col--tap-hover"
            bindtap="onOpenMutualType"
          >
            <text class="types-label">{{mutualTypesLabel}}</text>
            <text class="types-code">{{mutualType}}</text>
            <text class="types-alias">{{mutualAlias}}</text>
          </view>
        </view>
      </view>

      <view class="card card-score">
        <text class="score-num">{{score}}%</text>
        <text class="score-cap">认知贴合度</text>
        <text class="score-title">{{title}}</text>
      </view>

      <view class="card card-note">
        <text class="note-p" wx:for="{{lines}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="btn-copy" bindtap="onCopy">复制分析文案</view>
      <view class="scroll-pad"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 性格说明弹窗（与 info 页同源数据，仅占位本页交互） -->
  <view wx:if="{{typeModalVisible && modalTypeItem}}" class="type-modal-root" catchtouchmove="onTypeModalCatchMove">
    <view class="type-modal-backdrop" bindtap="onCloseTypeModal"></view>
    <view class="type-modal-panel">
      <view class="type-modal-bar">
        <text class="type-modal-bar-title">性格类型说明</text>
        <text class="type-modal-bar-close" bindtap="onCloseTypeModal">关闭</text>
      </view>
      <scroll-view scroll-y class="type-modal-scroll" show-scrollbar="{{false}}">
        <view class="type-modal-inner">
          <view class="type-modal-type-row">
            <text class="type-modal-code">{{modalTypeItem.type}}</text>
            <text class="type-modal-alias">{{modalTypeItem.alias}}</text>
          </view>
          <view wx:if="{{modalTypeItem.keywords.length > 0}}" class="type-modal-keywords">
            <view class="type-modal-kw" wx:for="{{modalTypeItem.keywords}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="type-modal-section">
            <text class="type-modal-st">类型简介</text>
            <text class="type-modal-body">{{modalTypeItem.summary}}</text>
          </view>
          <view class="type-modal-section">
            <text class="type-modal-st">性格优势</text>
            <text class="type-modal-body">{{modalTypeItem.strengths}}</text>
          </view>
          <view class="type-modal-section">
            <text class="type-modal-st">适合方向</text>
            <text class="type-modal-body">{{modalTypeItem.fit}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="type-modal-footer">
        <view class="type-modal-done" bindtap="onCloseTypeModal">知道了</view>
      </view>
    </view>
  </view>
</view>
